'use client'
import { useState } from 'react'
import AppShell from '@/components/AppShell'
import { Heart } from 'lucide-react'

const ALREADY = [
  { emoji: '🌹', who: 'João F.' },
  { emoji: '🕯', who: 'Ana S.' },
  { emoji: '🌻', who: 'família Costa' },
  { emoji: '🕯', who: 'Miguel R.' },
  { emoji: '🌸', who: 'Pedro S.' },
]

const FLOWERS = [
  { id: 'rosa',      emoji: '🌹', name: 'Rosa',      desc: 'Um gesto simples de carinho',   price: 99  },
  { id: 'ramalhete', emoji: '💐', name: 'Ramalhete', desc: 'Para uma homenagem especial',   price: 299, featured: true },
  { id: 'girassol',  emoji: '🌻', name: 'Girassol',  desc: 'Alegria que não se apaga',      price: 149 },
]

const CANDLES = [
  { id: 'vela',    emoji: '🕯', name: 'Vela acesa', desc: 'Que a sua luz brilhe sempre', price: 99  },
  { id: 'coroa',   emoji: '🌸', name: 'Coroa',      desc: 'Homenagem duradoura',         price: 499 },
  { id: 'surpresa',emoji: '🎁', name: 'Surpresa',   desc: 'Numa data especial',           price: 199 },
]

function Card({ p, selected, onSelect }: { p: any, selected: string|null, onSelect: (id: string) => void }) {
  const on = selected === p.id
  return (
    <button onClick={() => onSelect(p.id)} style={{ background: on ? '#fffdf8' : 'var(--card)', border: on ? '2px solid var(--gold)' : p.featured ? '1.5px solid var(--gold-b)' : '1px solid var(--sep)', borderRadius: 12, padding: '14px 12px', textAlign: 'center', cursor: 'pointer', transition: 'all .15s', fontFamily: 'DM Sans, sans-serif' }}>
      <span style={{ fontSize: 28, display: 'block', marginBottom: 8 }}>{p.emoji}</span>
      <div style={{ fontSize: 13, fontWeight: 500, color: 'var(--text)', marginBottom: 3 }}>{p.name}</div>
      <div style={{ fontSize: 11, color: 'var(--text3)', marginBottom: 10, lineHeight: 1.4 }}>{p.desc}</div>
      <div style={{ fontSize: 14, fontWeight: 500, color: 'var(--gold)' }}>€{(p.price/100).toFixed(2).replace('.',',')}</div>
    </button>
  )
}

export default function FloresPage() {
  const [selected, setSelected] = useState<string|null>(null)
  const [message, setMessage] = useState('')
  const all = [...FLOWERS, ...CANDLES]
  const sel = all.find(p => p.id === selected)

  return (
    <AppShell>
      <div style={{ maxWidth: 680, margin: '0 auto' }}>
        <div style={{ background: 'var(--night)', padding: '22px 22px 18px' }}>
          <div style={{ fontSize: 12, color: 'rgba(240,232,216,0.45)', marginBottom: 4 }}>Oferecer à memória de</div>
          <h1 style={{ fontFamily: 'Playfair Display, serif', fontSize: 20, fontWeight: 500, color: '#f0e8d8', marginBottom: 14 }}>Maria Helena Sousa</h1>
          <div style={{ fontSize: 11, color: 'rgba(240,232,216,0.4)', marginBottom: 8, letterSpacing: '0.04em', textTransform: 'uppercase' }}>Já oferecido hoje</div>
          <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap' }}>
            {ALREADY.map((a, i) => (
              <div key={i} style={{ background: 'rgba(255,255,255,0.07)', border: '1px solid rgba(255,255,255,0.1)', borderRadius: 99, padding: '4px 10px', fontSize: 12, color: 'rgba(240,232,216,0.65)', display: 'flex', alignItems: 'center', gap: 4 }}>
                {a.emoji} {a.who}
              </div>
            ))}
          </div>
        </div>
        <div style={{ padding: 16, background: 'var(--bg)' }}>
          <div style={{ fontSize: 11, color: 'var(--text3)', fontWeight: 500, letterSpacing: '0.07em', textTransform: 'uppercase', marginBottom: 12 }}>Flores</div>
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3,1fr)', gap: 10, marginBottom: 18 }}>
            {FLOWERS.map(p => <Card key={p.id} p={p} selected={selected} onSelect={setSelected} />)}
          </div>
          <div style={{ fontSize: 11, color: 'var(--text3)', fontWeight: 500, letterSpacing: '0.07em', textTransform: 'uppercase', marginBottom: 12 }}>Velas & homenagens</div>
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3,1fr)', gap: 10, marginBottom: 18 }}>
            {CANDLES.map(p => <Card key={p.id} p={p} selected={selected} onSelect={setSelected} />)}
          </div>
          <div style={{ background: 'var(--card)', border: '1px solid var(--sep)', borderRadius: 12, padding: 16 }}>
            <div style={{ fontSize: 12, color: 'var(--text2)', marginBottom: 8 }}>✏️ Adicionar mensagem (opcional)</div>
            <input type="text" placeholder="Ex: Com eterna saudade, da família toda..." value={message} onChange={e => setMessage(e.target.value)} style={{ width: '100%', padding: '9px 12px', background: 'var(--bg)', border: '1px solid var(--sep2)', borderRadius: 8, fontSize: 13, color: 'var(--text)', fontFamily: 'DM Sans, sans-serif', marginBottom: 10 }} />
            <div style={{ fontSize: 11, color: 'var(--text3)', marginBottom: 12 }}>A mensagem ficará visível no memorial para todos os visitantes.</div>
            <button disabled={!selected} style={{ width: '100%', padding: '10px 0', background: selected ? 'var(--night)' : 'var(--bg3)', color: selected ? '#f0e8d8' : 'var(--text3)', border: 'none', borderRadius: 9, fontSize: 13, fontWeight: 500, cursor: selected ? 'pointer' : 'not-allowed', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 7, fontFamily: 'DM Sans, sans-serif' }}>
              <Heart size={14} />
              {sel ? `Confirmar oferta · €${(sel.price/100).toFixed(2).replace('.',',')}` : 'Selecciona uma oferta'}
            </button>
          </div>
        </div>
      </div>
    </AppShell>
  )
}
